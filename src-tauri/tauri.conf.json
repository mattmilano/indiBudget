{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "indiBudget",
  "version": "1.0.0",
  "identifier": "com.indomitusgroup.indibudget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGtkAppId": true,
    "windows": [
      {
        "title": "indiBudget",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://beta-bridge.simplefin.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "mainBinaryName": "indiBudget",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Personal budget application",
    "longDescription": "A calendar-focused personal budget application for tracking income, expenses, and financial goals.",
    "linux": {
      "deb": {
        "desktopTemplate": "desktop-template.desktop"
      },
      "rpm": {
        "desktopTemplate": "desktop-template.desktop"
      }
    }
  },
  "plugins": {}
}
